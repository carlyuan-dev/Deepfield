{
  "name": "deepfield",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:search": "vitest run --config vitest.live.config.ts packages/retrieval/src/benchmark/search-benchmark.live.test.ts",
    "test:providers:live": "vitest run --bail=1 --config vitest.live.config.ts packages/retrieval/src/providers/provider-contract.live.test.ts",
    "test:metaso-shape:live": "vitest run --config vitest.live.config.ts packages/retrieval/src/providers/metaso-shape.live.test.ts",
    "test:e2e": "npm run build && playwright test",
    "dist:dir": "npm run build && electron-builder --mac --arm64 --dir",
    "dist:local": "npm run build && electron-builder --mac dmg zip --arm64 --config.mac.identity=null",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "docx": "^9.7.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "typebox": "1.3.7",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
